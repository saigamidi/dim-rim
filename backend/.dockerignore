# Backend .dockerignore - exclude files not needed in the Docker image

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.tox/

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment files
.env
*.env
!dev.env

# Database files
*.db
*.sqlite
*.sqlite3

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Tests (already in image)
# tests/

# Documentation
*.md
!README.md

# Git
.git/
.gitignore
.gitattributes

# CI/CD
.github/

# Logs
*.log

# OS
.DS_Store
Thumbs.db
