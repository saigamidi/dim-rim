# Root context .dockerignore for frontend Dockerfile build
# This is used when building from context: . with dockerfile: frontend/Dockerfile

# Exclude backend entirely
backend/

# Exclude frontend build artifacts and dev files
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.env
frontend/.env.local
frontend/.env.*.local
frontend/coverage/
frontend/.nyc_output/
frontend/test-results/
frontend/playwright-report/
frontend/playwright/.cache/

# Exclude git and CI
.git/
.gitignore
.gitattributes
.github/

# Exclude IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Exclude logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Exclude OS files
.DS_Store
Thumbs.db

# Exclude root artifacts
.handoff/
graphify-out/

# Exclude PIDs and temp files
.pids
*.tmp
*.bak
