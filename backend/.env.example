# Backend Environment Configuration
# Copy this file to .env and adjust values as needed

# Database URL
# SQLite (local development): sqlite:///./app.db
# PostgreSQL (production): postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./app.db

# Security keys - CHANGE THESE IN PRODUCTION
SECRET_KEY=change-this-secret-key-in-production
JWT_SECRET_KEY=change-this-jwt-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Debug mode (set to false in production)
DEBUG=true

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Seed data on startup (useful for development)
SEED_DATA=true

# Rate limiting (set to true in production)
RATE_LIMIT_ENABLED=false
