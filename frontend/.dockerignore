# Frontend .dockerignore - exclude files not needed in the Docker image

# Dependencies
node_modules/

# Build outputs (will be regenerated)
dist/
build/

# Environment files
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Tests
coverage/
.nyc_output/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# Git
.git/
.gitignore
.gitattributes

# CI/CD
.github/

# E2E test artifacts
test-results/
playwright-report/
playwright/.cache/

# Documentation
*.md
!README.md
